{
  "name": "@chess-platform/anti-cheat",
  "version": "0.1.0",
  "description": "Pure deterministic anti-cheat analyzers: engine-correlation scoring and behavioral bot detection.",
  "license": "AGPL-3.0-or-later",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "require": "./dist/engine.js",
      "import": "./dist/engine.js",
      "default": "./dist/engine.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/test/**/*.test.js\"",
    "lint": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist dist-test"
  },
  "keywords": [
    "chess",
    "anti-cheat",
    "engine-correlation"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@chess-platform/core": "file:../chess-core",
    "@chess-platform/engine": "file:../engine"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^20.0.0"
  }
}
