{
  "name": "@chess-platform/core",
  "version": "0.1.0",
  "description": "Fully-typed, variant-aware chess rules engine (perft-verified).",
  "license": "AGPL-3.0-or-later",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/test/**/*.test.js\"",
    "lint": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist dist-test"
  },
  "keywords": [
    "chess",
    "chess960",
    "atomic",
    "crazyhouse",
    "perft",
    "typescript"
  ],
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.5.0"
  }
}
