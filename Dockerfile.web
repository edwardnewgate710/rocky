# --- Build stage ---
FROM node:22-slim AS builder

WORKDIR /app

COPY package.json package-lock.json ./
COPY packages/ ./packages/

RUN npm ci

# Build the web package (tsc + vite build)
RUN npm run build --workspace @chess-platform/web

# --- Runtime stage: nginx serving static files ---
# nginxinc/nginx-unprivileged runs as a non-root user by default and listens
# on 8080 (privileged port 80 requires root, which this image intentionally
# does not run as).
FROM nginxinc/nginx-unprivileged:alpine AS runtime

# Copy the built SPA
COPY --from=builder /app/packages/web/dist/ /usr/share/nginx/html/

# Copy nginx config that proxies /v1 and /ws
COPY docker/web/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
