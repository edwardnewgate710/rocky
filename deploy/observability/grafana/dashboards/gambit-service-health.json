{
  "uid": "gambit-service-health",
  "title": "Gambit — Service health & SLOs",
  "description": "API availability, latency and error-budget burn. Panels read the recording rules in gambit.rules.yml rather than re-deriving PromQL, so a dashboard and its alerts can never disagree.",
  "tags": ["gambit", "slo"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "SLO status",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Availability (30d)",
      "description": "1 - 5xx ratio. 4xx is client error and is deliberately excluded. SLO target: 99.5%.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0.98,
          "max": 1,
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.995 },
              { "color": "green", "value": 0.999 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - (sum(rate(http_requests_total{status=~\"5..\"}[30d])) / sum(rate(http_requests_total[30d])))",
          "legendFormat": "availability"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Fast responses (30d)",
      "description": "Share of requests served within 250 ms. 0.25s is a real histogram bucket boundary, so this figure is exact rather than interpolated. SLO target: 99%.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0.9,
          "max": 1,
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.99 },
              { "color": "green", "value": 0.995 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_request_duration_seconds_bucket{le=\"0.25\"}[30d])) / sum(rate(http_request_duration_seconds_count[30d]))",
          "legendFormat": "under 250ms"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Availability error budget remaining (30d)",
      "description": "100% means the full 0.5% budget is intact; 0% means it is spent and every further 5xx is over budget.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.25 },
              { "color": "green", "value": 0.5 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - ((sum(rate(http_requests_total{status=~\"5..\"}[30d])) / sum(rate(http_requests_total[30d]))) / 0.005)",
          "legendFormat": "budget left"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Current burn rate (1h)",
      "description": "Multiples of the sustainable error rate. 1x exactly exhausts the budget over 30 days; 14.4x pages.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 3 },
              { "color": "red", "value": 14.4 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "gambit:api_error:ratio_rate1h / 0.005",
          "legendFormat": "burn rate"
        }
      ]
    },
    {
      "id": 6,
      "type": "row",
      "title": "Traffic and errors",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Request rate by route",
      "description": "route is the route PATTERN, never the raw path — cardinality is bounded on purpose.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(http_requests_total[5m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "5xx ratio (SLI)",
      "description": "The recorded SLI the burn-rate alerts fire on.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0 } },
      "targets": [
        { "refId": "A", "expr": "gambit:api_error:ratio_rate5m", "legendFormat": "5m" },
        { "refId": "B", "expr": "gambit:api_error:ratio_rate1h", "legendFormat": "1h" }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Responses by status class",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_requests_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Latency quantiles",
      "description": "Derived from the histogram; resolution is limited by the bucket edges [5ms .. 10s].",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 11,
      "type": "row",
      "title": "Realtime gateway",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Connections opened / messages received",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(gateway_connections_opened_total[5m]))",
          "legendFormat": "connections opened"
        },
        {
          "refId": "B",
          "expr": "sum(rate(gateway_messages_received_total[5m]))",
          "legendFormat": "messages received"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "WebSocket auth failures",
      "description": "A sustained non-zero rate is either an ACCESS_TOKEN_SECRET mismatch between gateway and API, or credential stuffing against the socket.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 },
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0 } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(gateway_auth_failures_total[5m]))",
          "legendFormat": "auth failures"
        }
      ]
    }
  ]
}
