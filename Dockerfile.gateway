# --- Build stage ---
FROM node:22-slim AS builder

WORKDIR /app

COPY package.json package-lock.json ./
COPY packages/ ./packages/
COPY services/ ./services/

# Install dependencies for the workspace packages
RUN npm ci

# Build all dependency packages in order
RUN npm run build --workspace @chess-platform/core && \
    npm run build --workspace @chess-platform/game && \
    npm run build --workspace @chess-platform/realtime-gateway && \
    npm run build --workspace @chess-platform/persistence && \
    npm run build --workspace @chess-platform/api

# Build the gateway service (not in npm workspaces — compile directly)
RUN cd services/gateway && npx tsc -p tsconfig.json

# --- Runtime stage ---
FROM node:22-slim AS runtime

WORKDIR /app

COPY --from=builder --chown=node:node /app/package.json /app/package-lock.json ./
COPY --from=builder --chown=node:node /app/packages/ ./packages/
COPY --from=builder --chown=node:node /app/services/ ./services/
COPY --from=builder --chown=node:node /app/node_modules/ ./node_modules/

ENV NODE_ENV=production
ENV PORT=4175

EXPOSE 4175 4176

USER node

CMD ["node", "services/gateway/dist/serve.js"]
