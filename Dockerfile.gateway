# --- Build stage ---
FROM node:22-slim AS builder

WORKDIR /app

COPY package.json package-lock.json ./
COPY packages/ ./packages/
COPY services/ ./services/

# Install dependencies for the workspace packages
RUN npm ci

# Build all dependency packages in order
# Delegates to the root `build:server` script — see the note in Dockerfile.api. The chain used to
# be duplicated here too, with the same missing packages. ADR-0065.
RUN npm run build:server

# Install/build the non-workspace service from its own lockfile, then remove
# TypeScript and all other development-only packages from both dependency trees.
RUN npm ci --prefix services/gateway && \
    npm run build --prefix services/gateway && \
    npm prune --omit=dev && \
    npm prune --omit=dev --prefix services/gateway

# --- Runtime stage ---
FROM node:22-slim AS runtime

WORKDIR /app

COPY --from=builder --chown=node:node /app/package.json /app/package-lock.json ./
COPY --from=builder --chown=node:node /app/node_modules/ ./node_modules/
COPY --from=builder --chown=node:node /app/services/gateway/package.json ./services/gateway/package.json
COPY --from=builder --chown=node:node /app/services/gateway/dist/ ./services/gateway/dist/
COPY --from=builder --chown=node:node /app/services/gateway/node_modules/ ./services/gateway/node_modules/
# npm represents local file dependencies as links back to /app/packages. Copy
# only their manifests and compiled output so those links remain valid without
# shipping source and tests.
COPY --from=builder --chown=node:node /app/packages/chess-core/package.json ./packages/chess-core/package.json
COPY --from=builder --chown=node:node /app/packages/chess-core/dist/ ./packages/chess-core/dist/
COPY --from=builder --chown=node:node /app/packages/search/package.json ./packages/search/package.json
COPY --from=builder --chown=node:node /app/packages/search/dist/ ./packages/search/dist/
COPY --from=builder --chown=node:node /app/packages/social/package.json ./packages/social/package.json
COPY --from=builder --chown=node:node /app/packages/social/dist/ ./packages/social/dist/
COPY --from=builder --chown=node:node /app/packages/messaging/package.json ./packages/messaging/package.json
COPY --from=builder --chown=node:node /app/packages/messaging/dist/ ./packages/messaging/dist/
COPY --from=builder --chown=node:node /app/packages/engine/package.json ./packages/engine/package.json
COPY --from=builder --chown=node:node /app/packages/engine/dist/ ./packages/engine/dist/
COPY --from=builder --chown=node:node /app/packages/anti-cheat/package.json ./packages/anti-cheat/package.json
COPY --from=builder --chown=node:node /app/packages/anti-cheat/dist/ ./packages/anti-cheat/dist/
COPY --from=builder --chown=node:node /app/packages/game/package.json ./packages/game/package.json
COPY --from=builder --chown=node:node /app/packages/game/dist/ ./packages/game/dist/
COPY --from=builder --chown=node:node /app/packages/tournament/package.json ./packages/tournament/package.json
COPY --from=builder --chown=node:node /app/packages/tournament/dist/ ./packages/tournament/dist/
COPY --from=builder --chown=node:node /app/packages/realtime-gateway/package.json ./packages/realtime-gateway/package.json
COPY --from=builder --chown=node:node /app/packages/realtime-gateway/dist/ ./packages/realtime-gateway/dist/
COPY --from=builder --chown=node:node /app/packages/persistence/package.json ./packages/persistence/package.json
COPY --from=builder --chown=node:node /app/packages/persistence/dist/ ./packages/persistence/dist/
COPY --from=builder --chown=node:node /app/packages/api/package.json ./packages/api/package.json
COPY --from=builder --chown=node:node /app/packages/api/dist/ ./packages/api/dist/

ENV NODE_ENV=production
ENV PORT=4175

EXPOSE 4175 4176

USER node

CMD ["node", "services/gateway/dist/serve.js"]
